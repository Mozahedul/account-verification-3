<mjml>
  <mj-head>
    <!-- Email Subject Preview -->
    <mj-preview>
      Limited-time offer on handcrafted ceramic mugs. Shop now before it's gone.
    </mj-preview>

    <!-- Breakpoint -->
    <mj-breakpoint width="480px" />

    <!-- Email Title -->
    <mj-title>Obsidian Ceramic Mug – Special Offer</mj-title>

    <!-- Google Font -->
    <mj-font
      name="Roboto"
      href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
    />

    <!--
    ================================================
      COLOR SYSTEM
    ================================================

      LIGHT MODE
      ----------
      Email outer bg        → #f4f4f4
      Section bg            → #ffffff
      Card bg               → #f8f8f8
      Border                → #e8e8e8
      Heading               → #111111
      Subheading            → #444444
      Body text             → #666666
      Muted                 → #888888
      Footer text           → #999999

      DARK MODE
      ----------
      Email outer bg        → #111111
      Section bg            → #1a1a1a
      Card bg               → #222222
      Border                → #333333
      Heading               → #f0f0f0
      Subheading            → #cccccc
      Body text             → #aaaaaa
      Muted                 → #888888
      Footer text           → #666666

      ACCENT (both modes)
      -------------------
      Primary green         → #1a5c38
      Amber                 → #c97d2e

      DIVIDERS
      --------
      Light                 → #e8e8e8  (dark: #333333)
      Strong                → #cccccc  (dark: #444444)
    ================================================
    -->
    <!-- Global Attributes -->
    <mj-attributes>
      <!-- Entire Email -->
      <mj-all
        font-family="'Roboto', Georgia, 'Times New Roman', serif"
        color="#444444"
        line-height="1.5"
      />

      <!-- Body -->
      <mj-body background-color="#f4f4f4" />

      <!-- Sections -->
      <mj-section padding="0" background-color="#ffffff" />

      <!-- Columns -->
      <mj-column padding="0" />

      <!-- Text -->
      <mj-text
        padding="0"
        font-size="16px"
        line-height="24px"
        color="#444444"
      />

      <!-- Buttons — primary default -->
      <mj-button
        border-radius="4px"
        font-size="14px"
        font-weight="600"
        inner-padding="14px 28px"
        padding="0"
        background-color="#111111"
        color="#ffffff"
      />

      <!-- Images -->
      <mj-image padding="0" border="0" fluid-on-mobile="true" />

      <!-- Divider -->
      <mj-divider
        border-style="solid"
        border-color="#e8e8e8"
        border-width="1px"
        width="100%"
        align="left"
        padding="15px 0"
      />
    </mj-attributes>

    <!-- STYLE BLOCK 1: Inlined regular styles -->
    <mj-style inline="inline">
      a {
        text-decoration: none;
      }
      img {
        display: block;
        border: 0;
        outline: none;
        text-decoration: none;
      }
      p {
        margin: 0;
        padding: 0;
      }
    </mj-style>

    <!-- Raw meta tags -->
    <mj-raw>
      <meta charset="UTF-8" /> <meta http-equiv="X-UA-Compatible"
      content="IE=edge" /> <meta name="viewport" content="width=device-width,
      initial-scale=1.0" /> <meta name="format-detection" content="telephone=no,
      date=no, address=no, email=no, url=no" /> <meta
      name="x-apple-disable-message-reformatting" /> <meta
      http-equiv="List-Unsubscribe"
      content="<mailto:unsubscribe@example.com?subject=unsubscribe>,
      <https://example.com/unsubscribe>" />
    </mj-raw>
  </mj-head>

  <mj-body width="600px" background-color="#ffffff">
    <!-- ============================================================ -->
    <!-- LOGO                                                          -->
    <!-- ============================================================ -->
    <mj-section background-color="#ffffff" css-class="dm-bg-section">
      <mj-column vertical-align="top">
        <mj-image
          fluid-on-mobile="false"
          src="./images/similar-web-logo.png"
          alt="Ultimate Technology Limited"
          href="https://mjml.io/product?utm_source=email&utm_medium=newsletter&utm_campaign=summer_sale"
          padding="30px 0px"
          width="130px"
        />
      </mj-column>
    </mj-section>

    <mj-wrapper padding="0px 30px">
      <mj-section border="1px solid #f4f4f4" padding="30px">
        <mj-column>
          <mj-text
            font-size="18px"
            font-weight="400"
            color="#111111"
            text-transform="capitalize"
          >
            Hey smiles davis,
          </mj-text>
          <mj-text
            padding="12px 0px 0px"
            font-size="15px"
            line-height="1.4"
            color="#111111"
          >
            Your account was recently logged into from an unrecognized device.
            In or der to preserve the security and privacy of your account,
            please use the code below to complete the login verification
            process.
          </mj-text>
          <mj-text
            padding="15px 0px 0px"
            font-size="15px"
            line-height="1.4"
            color="#111111"
          >
            <span
              >If you didn't attempt to login just now, please contact
            </span>
            <a href="#">support@similarweb.com</a>
          </mj-text>
          <mj-text
            align="center"
            font-size="24px"
            color="#111111"
            font-weight="700"
            padding="15px 0px"
          >
            650050
          </mj-text>
          <!-- MJML Large Button -->

          <mj-button
            line-height="1.1"
            font-size="14px"
            font-weight="400"
            background-color="#4F8DF9"
            text-transform="uppercase"
            href="https://taqwaitagency.com"
            inner-padding="12px 30px"
            padding="15px 0px"
            border-radius="40px"
          >
            Verify login
          </mj-button>

          <mj-text font-size="15px" font-weight="400">
            <span>Have a great day,</span><br />
            <span>Your team @SimilarWeb</span>
          </mj-text>
          <mj-text padding="20px 0px 0px" font-size="15px" color="#111111">
            <span>Need help? Contact</span>
            <a style="color: #2664ec" href="#">support@similarweb.com</a>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <!--
    mj spacer
    For creating horizontal space between sections
    -->
    <mj-section>
      <mj-column>
        <mj-spacer height="20px" />
      </mj-column>
    </mj-section>
    <!-- Social media icons -->
    <mj-section background-color="#ffffff" padding="30px 0">
      <mj-column>
        <mj-text align="center">
          <a
            href="https://facebook.com"
            target="_blank"
            style="display: inline-block"
          >
            <img
              src="https://res.cloudinary.com/ducp0w6mx/image/upload/v1779120948/email-portfolio/reset-password-email/icons/fb_yl0mxl.png"
              alt="facebook link"
              width="30px"
            />
          </a>
          <a
            href="https://x.com"
            target="_blank"
            style="display: inline-block; padding: 0px 15px"
          >
            <img
              src="https://res.cloudinary.com/ducp0w6mx/image/upload/v1779120949/email-portfolio/reset-password-email/icons/twitter_lpre05.png"
              alt="facebook link"
              width="30px"
            />
          </a>
          <a
            href="https://linkedin.com"
            target="_blank"
            style="display: inline-block"
          >
            <img
              src="https://res.cloudinary.com/ducp0w6mx/image/upload/v1779120948/email-portfolio/reset-password-email/icons/linkedin_punh68.png"
              alt="facebook link"
              width="30px"
            />
          </a>
        </mj-text>
        <mj-text font-size="14px" align="center" padding="15px 0px">
          <span>Feel free to</span>
          <a href="#" style="font-weight: bold; color: #2664ec">Contact Us</a>
        </mj-text>
        <mj-text font-size="13px" line-height="1.4" align="center">
          <span>@SimilarWeb LTD 2009 - 2017. All rights reserved.</span><br />
          <span>33 Irving Pl, New York, NY 10003</span>
        </mj-text>

        <mj-text align="center" font-size="12px" padding="30px 0px 0px">
          To stop receiving SimilarWeb emails entirely.
          <a href="#" style="text-decoration: underline; color: #2664ec">
            Unsubscribe here
          </a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
